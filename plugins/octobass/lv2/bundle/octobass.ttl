        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 2 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
