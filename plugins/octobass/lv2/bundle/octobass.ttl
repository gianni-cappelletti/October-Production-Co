        lv2:designation lv2:control
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "latency" ;
        lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency, lv2:integer, pprop:notOnGUI ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 192000.0 ;
        units:unit units:frame
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "enabled" ;
        lv2:name "Enabled" ;
        lv2:designation lv2:enabled ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "crossover" ;
        lv2:name "Crossover" ;
        lv2:default 250.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 800.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "hertz" ;
            units:symbol "Hz" ;
            units:render "%.0f Hz"
