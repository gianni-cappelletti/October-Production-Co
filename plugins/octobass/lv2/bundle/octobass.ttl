        lv2:index 27 ;
        lv2:symbol "nam2_output_mode" ;
        lv2:name "NAM 2 Output Mode" ;
        lv2:shortName "NAM 2 Out Mode" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [
            rdfs:label "Raw" ;
            rdf:value 0.0
        ] , [
            rdfs:label "Normalized" ;
