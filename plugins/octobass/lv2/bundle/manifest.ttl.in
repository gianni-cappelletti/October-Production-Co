@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/gianni-cappelletti/October-Production-Co/plugins/octobass>
    a lv2:Plugin ;
    lv2:binary <@OCTOBASS_LV2_BINARY@> ;
    lv2:minorVersion @OCTOBASS_LV2_MINOR_VERSION@ ;
    lv2:microVersion @OCTOBASS_LV2_MICRO_VERSION@ ;
    rdfs:seeAlso <octobass.ttl> , <modgui.ttl> .

<https://github.com/gianni-cappelletti/October-Production-Co/plugins/octobass#preset-default>
    a pset:Preset ;
    lv2:appliesTo <https://github.com/gianni-cappelletti/October-Production-Co/plugins/octobass> ;
    rdfs:seeAlso <presets.ttl> .
